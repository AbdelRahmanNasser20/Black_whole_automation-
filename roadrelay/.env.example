# ============================================
# RoadRelay - Environment Configuration
# ============================================
NODE_ENV=development
PORT=3000
APP_NAME=roadrelay
APP_BASE_URL=http://localhost:3000
LOG_LEVEL=info

# ============================================
# PostgreSQL
# ============================================
DATABASE_URL=postgres://roadrelay:roadrelay@localhost:5432/roadrelay
DATABASE_POOL_MAX=20
DATABASE_SSL=false

# ============================================
# Redis (cache, rate limit, queues)
# ============================================
REDIS_URL=redis://localhost:6379/0
REDIS_RATE_LIMIT_DB=1
REDIS_QUEUE_DB=2

# ============================================
# JWT / Auth
# ============================================
# Generate with: openssl rand -base64 64
JWT_ACCESS_SECRET=replace-me-in-production
JWT_REFRESH_SECRET=replace-me-in-production
JWT_ACCESS_TTL=900            # 15 minutes
JWT_REFRESH_TTL=2592000       # 30 days

# OTP
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN=60

# ============================================
# S3-compatible storage (for verification artifacts)
# ============================================
STORAGE_DRIVER=s3            # s3 | minio | local
S3_ENDPOINT=https://s3.amazonaws.com
S3_REGION=us-east-1
S3_BUCKET=roadrelay-artifacts
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PRESIGN_TTL=600

# ============================================
# Notification provider (abstract)
# ============================================
NOTIFICATION_DRIVER=stub      # stub | sns | fcm | apns
SMS_DRIVER=stub               # stub | twilio | sns | messagebird
SMS_FROM=+10000000000

# ============================================
# Relay (masked communication) provider
# ============================================
RELAY_DRIVER=internal         # internal | twilio_proxy | bandwidth | sinch
RELAY_SESSION_TTL=86400       # 24h default

# ============================================
# Rate limiting
# ============================================
RATE_LIMIT_GLOBAL_RPM=600
RATE_LIMIT_AUTH_RPM=10
RATE_LIMIT_PLATE_LOOKUP_RPD=30
RATE_LIMIT_CONTACT_REQ_RPD=10

# ============================================
# Encryption (PII at rest)
# ============================================
# 32-byte base64 key for envelope encryption of phone numbers etc.
PII_ENCRYPTION_KEY=replace-with-32-byte-base64
PII_ENCRYPTION_KEY_ID=v1

# ============================================
# Admin
# ============================================
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
